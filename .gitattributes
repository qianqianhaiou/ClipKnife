# Keep generated bytes stable across Windows checkouts and manifest validation.
/demo/** text eol=lf
/demo/src/assets/*.webp binary
/docs/demo/** text eol=lf
/docs/assets/demo/** text eol=lf
/docs/assets/demo/*.webp binary
# Bundled vendor CSS template literals retain whitespace-only lines verbatim.
/docs/assets/demo/main.js whitespace=-blank-at-eol
/docs/assets/demo-host.* text eol=lf
/scripts/demo-visual/** text eol=lf
/tests/demo-*.test.cjs text eol=lf
